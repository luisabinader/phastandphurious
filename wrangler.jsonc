{
  "name": "phastandphurious",
  "main": "src/worker.js",
  "compatibility_date": "2026-08-01",
  "assets": {
    "directory": "public",
    "binding": "ASSETS"
  },
  "durable_objects": {
    "bindings": [{ "name": "ROOM", "class_name": "Room" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Room"] }],
  "routes": [
    { "pattern": "phastandphurious.org", "custom_domain": true },
    { "pattern": "www.phastandphurious.org", "custom_domain": true }
  ],
  "observability": { "enabled": true }
}
